generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  draft
  pending
  partially_paid
  paid
}

// Team roles. Owner is the account creator; admin helps run the workspace;
// staff does day-to-day invoicing; viewer can only read.
enum MembershipRole {
  owner
  admin
  staff
  viewer
}

enum RecurringFrequency {
  weekly
  monthly
  quarterly
  yearly
}

// A workspace is the tenant for ALL business data (clients, invoices,
// products, settings, business profile, recurring schedules). A user belongs
// to one or more workspaces via Membership; every token names the active
// workspace and every query is scoped to it.
model Workspace {
  id           String             @id @default(uuid())
  name         String
  // userId of whoever created the workspace (audit).
  createdBy    String
  // Shareable join code; regenerated by an owner/admin via /api/workspaces/invite.
  inviteCode   String?            @unique
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  members      Membership[]
  settings     WorkspaceSettings?
  businessProfile BusinessProfile?
  clients      Client[]
  invoices     Invoice[]
  products     Product[]
  recurringInvoices RecurringInvoice[]
  notifications Notification[]
  emailLogs    EmailLog[]
  paymentAttempts PaymentAttempt[]
  payments     Payment[]
}

model Membership {
  id          String         @id @default(uuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        MembershipRole @default(staff)
  createdAt   DateTime       @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model User {
  id           String           @id @default(uuid())
  name         String
  email        String           @unique
  passwordHash String
  // Uploaded profile picture (the "avatar"). Stored as a /uploads/... path
  // served from server.js; null means the app falls back to initials.
  avatarUrl    String?
  // Password reset (forgot-password flow). We store a SHA-256 hash of the
  // reset token (never the raw token) plus an expiry; both clear on use.
  passwordResetTokenHash String?
  passwordResetExpiresAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  memberships  Membership[]
  // Attribution columns: the workspace owns data, but we record who created it.
  clients      Client[]
  invoices     Invoice[]
  products     Product[]
  notifications Notification[]
  emailLogs    EmailLog[]
}

// Workspace-level billing/tax/numbering settings. Invoice numbering is shared
// by the whole team, so the counter lives here (not per user).
model WorkspaceSettings {
  id                    String   @id @default(uuid())
  workspaceId           String   @unique
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  currency              String   @default("NPR")
  defaultPaymentTerms   Int      @default(30)
  invoicePrefix         String   @default("INV-")
  nextInvoiceNumber     Int      @default(1)
  defaultTaxRate        Decimal  @default(0)
  emailNotifications    Boolean  @default(true)
  paymentNotifications  Boolean  @default(true)
  reminderNotifications Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// The business's public identity, shared by the workspace (what appears on
// invoices and the PDF).
model BusinessProfile {
  id            String    @id @default(uuid())
  workspaceId   String    @unique
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // The user who set it up (audit).
  userId        String
  businessName  String
  email         String?
  phone         String?
  street        String?
  city          String?
  state         String?
  zipCode       String?
  country       String?
  taxNumber     String?
  logoUrl       String?
  bankName      String?
  routingNumber String?
  accountNumber String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Client {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  companyName String?
  email       String?
  phone       String?
  street      String?
  city        String?
  state       String?
  zipCode     String?
  country     String?
  taxNumber   String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  invoices    Invoice[]
  recurringInvoices RecurringInvoice[]

  @@index([workspaceId])
}

model Invoice {
  id            String        @id @default(uuid())
  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  invoiceNumber String
  status        InvoiceStatus @default(draft)
  issueDate     DateTime
  dueDate       DateTime
  paidAt        DateTime?
  // When the invoice was first emailed to the client.
  sentAt        DateTime?
  // View tracking: when the client first/last opened the invoice and how many
  // times. Stamped by the public pay-link view so staff can see a sent invoice
  // was actually opened (read receipt) before they chase it.
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  viewCount     Int           @default(0)
  // Unguessable token powering the public "Pay now" payment link so clients
  // can pay without an account. Backfilled for existing rows on migration.
  paymentToken  String?       @unique
  paymentAttempts PaymentAttempt[]
  // Set when this invoice was materialized by a recurring schedule.
  recurringId   String?
  recurring     RecurringInvoice? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  // Fixed-amount discount (in the business's currency), applied before tax:
  // total = (subtotal - discount) + tax on the discounted amount.
  discount      Decimal       @default(0)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         InvoiceItem[]
  payments      Payment[]
  auditLogs     AuditLog[]
  emailLogs     EmailLog[]

  @@index([workspaceId, status])
  // Invoice numbers are generated per workspace (WorkspaceSettings), so the
  // team shares one sequence and the number never collides within the team.
  @@unique([workspaceId, invoiceNumber])
}

// Recorded payments against an invoice. The invoice status is derived from
// these + the invoice total: sum(payments) < total -> partially_paid,
// sum(payments) >= total -> paid. Methods are free-form so new Nepali
// payment providers (eSewa, Khalti, bank transfer, etc.) don't need schema changes.
// A payment received or recorded. `amount` is negative for refunds.
// `kind` distinguishes money received ('payment') from money given back
// ('refund'); refunds point at the original row via refundOfId.
// `invoiceId` is NULL when money arrived but hasn't been matched to an invoice
// yet — that's an "unallocated" receipt, common when a client's bank transfer
// doesn't carry the invoice number. In-flight gateway bookings are tracked in
// PaymentAttempt (status pending), not here.
model Payment {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Decimal
  kind        String    @default("payment") // 'payment' | 'refund'
  status      String    @default("settled") // 'settled' — processing lives in PaymentAttempt
  method      String
  paymentDate DateTime  @default(now())
  reference   String?
  notes       String?
  refundOfId  String?
  refundOf    Payment?  @relation("PaymentRefunds", fields: [refundOfId], references: [id], onDelete: SetNull)
  refunds     Payment[] @relation("PaymentRefunds")
  createdAt   DateTime  @default(now())

  @@index([workspaceId, paymentDate])
  @@index([invoiceId])
  @@index([refundOfId])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Optional link back to the saved product this line was picked from.
  // NULL means it's a free-typed, one-off line item. Deleting a product leaves
  // the historical line items intact.
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Decimal
  unitPrice   Decimal

  @@index([productId])
}

// A business's reusable products & services. One workspace's catalog is
// isolated from every other workspace's. `stock` is tracked but not
// auto-decremented yet — services businesses can just ignore it and leave it at 0.
model Product {
  id          String       @id @default(uuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  // What kind of thing this is — shapes how it's billed and displayed:
  //   Service  — billed by the hour/unit of work (e.g. site development)
  //   Product  — a physical/digital good sold per unit (e.g. hosting)
  //   Retainer — a recurring thing billed per period (e.g. monthly SEO)
  type        String       @default("Service")
  description String?
  sku         String?
  price       Decimal
  taxRate     Decimal      @default(0)
  unit        String?
  stock       Int          @default(0)
  category    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  items       InvoiceItem[]
  recurringItems RecurringItem[]

  @@index([workspaceId])
}

// Real, append-only history of what actually happened to an invoice.
model AuditLog {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type      String
  message   String
  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// A recurring billing schedule. When the in-process scheduler finds an active
// schedule whose nextRunDate has passed, it materializes a real Invoice from
// the recurring items and advances nextRunDate by the frequency.
model RecurringInvoice {
  id           String              @id @default(uuid())
  workspaceId  String
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  description  String?
  frequency    RecurringFrequency
  startDate    DateTime
  nextRunDate  DateTime
  lastRunAt    DateTime?
  active       Boolean             @default(true)
  // Stop conditions (both optional, both honored by the scheduler):
  //   endDate        — stop generating once nextRunDate passes this date
  //   maxOccurrences — stop after this many invoices have been generated
  // occurrences    — how many invoices this schedule has generated so far
  endDate        DateTime?
  maxOccurrences Int?
  occurrences    Int      @default(0)
  // When true the scheduler auto-sends (moves to pending) each generated invoice;
  // when false generated invoices start as drafts for review.
  autoSend       Boolean  @default(true)
  discount     Decimal             @default(0)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        RecurringItem[]
  invoices     Invoice[]

  @@index([workspaceId, active])
}

// Template items for a recurring schedule — a copy of the "items" concept so
// the template survives edits to the generated invoices.
model RecurringItem {
  id                 String           @id @default(uuid())
  recurringInvoiceId String
  recurringInvoice   RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  description        String
  quantity           Decimal
  unitPrice          Decimal

  @@index([recurringInvoiceId])
}

// The per-user in-app notification feed ("bell" in the topbar). Created by
// event hooks in the routes and the scheduler. readAt null => unread.
model Notification {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoiceId   String?
  type        String
  title       String
  message     String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, readAt])
}

// Persistent record of every email we attempted to send, so the UI can show
// delivery history even when SMTP is not configured (simulated sends log here
// with ok=false + a marker so dev behavior is visible).
model EmailLog {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  type        String // invoice | reminder | batch
  to          String
  subject     String
  ok          Boolean
  simulated   Boolean
  error       String?
  sentAt      DateTime  @default(now())

  @@index([workspaceId, invoiceId])
}

// One checkout started against an invoice through a payment gateway (eSewa,
// simulated, future: Khalti, ConnectIPS). PaymentAttempt is the reconciliation
// ledger: a booking is created up front, and the gateway's status is resolved
// before any payment is recorded — so a payment can never be double-recorded,
// even when the gateway callback and the redirect-back both fire.
model PaymentAttempt {
  id              String   @id @default(uuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Amount in NPR requested (authoritative — the gateway only confirms status).
  amount          Float
  currency        String   @default("NPR")
  gateway         String   @default("esewa") // esewa | simulated | khalti…
  transactionUuid String // merchant-side unique id; re-used as the payment reference
  bookingId       String?  @unique // eSewa booking_id
  correlationId   String?
  // created | paid | partial | pending | failed | canceled
  status          String   @default("created")
  referenceCode   String? // gateway reference (e.g. 000DTSM)
  gatewayTxnId    String?
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([invoiceId])
  @@index([workspaceId, createdAt])
}