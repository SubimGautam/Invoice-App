generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  draft
  pending
  partially_paid
  paid
}

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  passwordHash    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  clients         Client[]
  invoices        Invoice[]
  products        Product[]
  businessProfile BusinessProfile?
  settings        UserSettings?
}

model BusinessProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName  String
  email         String?
  phone         String?
  street        String?
  city          String?
  state         String?
  zipCode       String?
  country       String?
  taxNumber     String?
  logoUrl       String?
  bankName      String?
  routingNumber String?
  accountNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UserSettings {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency              String   @default("NPR")
  defaultPaymentTerms   Int      @default(30)
  invoicePrefix         String   @default("INV-")
  nextInvoiceNumber     Int      @default(1)
  defaultTaxRate        Decimal  @default(0)
  emailNotifications    Boolean  @default(true)
  paymentNotifications  Boolean  @default(true)
  reminderNotifications Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Client {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  companyName String?
  email       String?
  phone       String?
  street      String?
  city        String?
  state       String?
  zipCode     String?
  country     String?
  taxNumber   String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  invoices    Invoice[]
}

model Invoice {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  invoiceNumber String
  status        InvoiceStatus @default(draft)
  issueDate     DateTime
  dueDate       DateTime
  paidAt        DateTime?
  // Fixed-amount discount (in the business's currency), applied before tax:
  // total = (subtotal - discount) + tax on the discounted amount.
  discount      Decimal       @default(0)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         InvoiceItem[]
  payments      Payment[]
  auditLogs     AuditLog[]

  @@index([userId, status])
  // Invoice numbers are generated per-user (UserSettings.nextInvoiceNumber), so
  // uniqueness has to be scoped to the user — not global — or a new user would
  // collide with every existing INV-0001.
  @@unique([userId, invoiceNumber])
}

// Recorded payments against an invoice. The invoice status is derived from
// these + the invoice total: sum(payments) < total -> partially_paid,
// sum(payments) >= total -> paid. Methods are free-form so new Nepali
// payment providers (eSewa, Khalti, bank transfer, etc.) don't need schema changes.
model Payment {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Decimal
  method      String
  paymentDate DateTime @default(now())
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Optional link back to the saved product this line was picked from.
  // NULL means it's a free-typed, one-off line item. Deleting a product leaves
  // the historical line items intact.
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Decimal
  unitPrice   Decimal

  @@index([productId])
}

// A business's reusable products & services. One user's catalog is isolated
// from every other user's. `stock` is tracked but not auto-decremented yet —
// services businesses can just ignore it and leave it at 0.
model Product {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sku         String?
  price       Decimal
  taxRate     Decimal      @default(0)
  unit        String?
  stock       Int          @default(0)
  category    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  items       InvoiceItem[]

  @@index([userId])
}

// Real, append-only history of what actually happened to an invoice.
model AuditLog {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type      String
  message   String
  createdAt DateTime @default(now())

  @@index([invoiceId])
}